<Window x:Class="DiscImageStudio.EasyModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        Title="{Binding Title}"
        Width="680" Height="780"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="NoticeTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" Grid.Column="0" Text="{Binding Glyph}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource HintText}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Blocker">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ProjectTitle="{Binding Title}" />

        <Grid Grid.Row="1" Margin="28,18,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Intro}" Style="{StaticResource BodyText}" Margin="0,0,0,14" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 1. The disc in the drive. -->
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding DiscSectionTitle}" Style="{StaticResource CardTitle}"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="{Binding RecorderLabel}" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        Content="{Binding InspectLabel}" Command="{Binding InspectCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="{Binding MediaSummary}" Style="{StaticResource RowText}"
                                       TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding PresetLabel}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Choices}"
                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                      DisplayMemberPath="Title" Margin="0,0,0,12" />

                            <ItemsControl ItemsSource="{Binding Notices}" ItemTemplate="{StaticResource NoticeTemplate}" />

                            <CheckBox Content="{Binding RememberLabel}" IsChecked="{Binding RememberChoice}"
                                      Visibility="{Binding CanRemember, Converter={StaticResource BoolToVisibility}}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. The picture to draw. -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding ImageSectionTitle}" Style="{StaticResource CardTitle}"
                                       Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ImageDisplay}" Style="{StaticResource RowText}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}"
                                        Content="{Binding BrowseLabel}" Command="{Binding BrowseImageCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding ProjectNameLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource HintText}"
                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8" />
                <Grid HorizontalAlignment="Right" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DialogAction" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DialogAction" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                            Content="{Binding CancelLabel}" Click="Cancel_Click" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                            Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" IsDefault="True" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
