<UserControl x:Class="DiscImageStudio.Views.BurnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiscImageStudio.Markup"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:DiscImageStudio.ViewModels">
    <!-- Binds the burn view model directly (State and NavigateCommand are exposed on it),
         like every other workspace page. -->
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel Margin="{StaticResource PagePadding}">
            <controls:PageHeader Title="{loc:T '刻录'}" Badge="{Binding FamilyLabel}"
                                 Workspace="{x:Static vm:Workspace.Burn}"
                                 Hint="{loc:T '即时刻录将数据直接流式写入空白盘片，不必单独生成镜像文件再刻录。'}" />

            <!-- Source: what lands on the disc. The switch is the page's own input selector,
                 the same pattern as the preview workspace's 输入原图/输入镜像; the summary
                 text below follows it. -->
            <controls:SectionCard Header="{loc:T '写入内容'}" IconKind="Flame" Margin="0,0,0,24">
                <StackPanel>
                    <controls:SegmentedControl HorizontalAlignment="Stretch" Margin="0,0,0,14"
                                               LabelA="{loc:T '设计页合成图'}" LabelB="{loc:T '辅助标定图案'}"
                                               IsSecondSelected="{Binding UseCalibrationPattern}" />
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource RadiusPanel}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding SourceDetails}" Style="{StaticResource HintText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- Calibration branch: the pattern is owned by the calibration workspace. -->
                    <controls:VisibilityGate IsOpen="{Binding UseCalibrationPattern}">
                        <Button Style="{StaticResource CompactButton}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Content="{loc:T '打开标定工作区'}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Workspace.Calibration}" />
                    </controls:VisibilityGate>
                </StackPanel>
            </controls:SectionCard>

            <controls:SectionCard Header="{loc:T '刻录机与速度'}" IconKind="Info" Margin="0,0,0,24"
                                  IsEnabled="{Binding IsSetupEnabled}">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T '刻录机'}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DisplayName" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                Command="{Binding RefreshDevicesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="RotateCw" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T '刷新'}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding DeviceStatusText}" Style="{StaticResource HintText}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:T '刻录速度'}" Margin="0,16,0,6" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Speeds}"
                                  SelectedItem="{Binding SelectedSpeed}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding IsSpeedComboEnabled}" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                IsEnabled="{Binding IsSpeedRefreshEnabled}"
                                Command="{Binding RefreshSpeedsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Disc" Width="14" Height="14"
                                                          VerticalAlignment="Center" />
                                <TextBlock Text="{loc:T '读取盘片'}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding SpeedStatusText}" Style="{StaticResource HintText}" />
                </StackPanel>
            </controls:SectionCard>

            <!-- Danger zone: the warning, its acknowledgement and the single action that
                 starts the write belong to one card. Progress is reported by the job dock. -->
            <Border Style="{StaticResource DangerCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <iconPacks:PackIconLucide Kind="TriangleAlert" Width="24" Height="24"
                                                  Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="{loc:T '刻录前确认'}" Style="{StaticResource CardTitle}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{DynamicResource WarningTextBrush}"
                               Text="{loc:T '流式刻录仅支持空白介质。刻录开始后，中断、断电或生成速度不足都可能导致盘片报废。'}" />
                    <CheckBox Content="{loc:T '我确认已放入正确的空白盘'}"
                              IsChecked="{Binding ConfirmChecked}" Margin="0,14,0,0"
                              IsEnabled="{Binding IsSetupEnabled}" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource DangerButton}" Content="{loc:T '开始流式刻录'}"
                                Command="{Binding StartBurnCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T '取消刻录'}"
                                Command="{Binding CancelBurnCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding BurnStatusText}" Style="{StaticResource CompactHint}"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
